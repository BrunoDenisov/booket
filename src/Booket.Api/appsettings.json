{
  "ConnectionStrings": {
    "Booket": ""
  },
  "Jwt": {
    "Issuer": "booket",
    "Audience": "booket-api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Notifications": {
    "ReminderOffsets": [ "1.00:00:00", "02:00:00" ]
  },
  "Outbox": {
    "DispatcherEnabled": true,
    "PollInterval": "00:00:10",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:01:00",
    "LeaseDuration": "00:02:00"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "no-reply@booket.local",
    "FromName": "Booket"
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 20
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*"
}
